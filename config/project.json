{
  "project_name": "Testing Management",
  "fields": [
    {
      "name": "Status",
      "type": "single_select",
      "options": [
        "Submitted",
        "Screening",
        "Awaiting Approval",
        "Awaiting Capacity",
        "Preparing",
        "Ready",
        "Scheduled",
        "Executed",
        "Analyzing",
        "Closed"
      ],
      "owner": "Testing Manager; reflects evidence, never grants authority"
    },
    {
      "name": "Disposition",
      "type": "single_select",
      "options": [
        "Active",
        "Clarification",
        "Deferred",
        "Declined",
        "Cancelled"
      ],
      "owner": "Testing Manager records documented decisions"
    },
    {
      "name": "Work type",
      "type": "single_select",
      "options": [
        "Test",
        "Preparation"
      ],
      "owner": "Testing Manager"
    },
    {
      "name": "Subsystem",
      "type": "single_select",
      "options": [
        "Drivetrain",
        "Suspension",
        "Brakes",
        "Electronics",
        "Vehicle integration",
        "Other"
      ],
      "owner": "Subsystem Lead; options confirmed on rollout"
    },
    {
      "name": "Priority",
      "type": "single_select",
      "options": [
        "Critical",
        "High",
        "Medium",
        "Low"
      ],
      "owner": "Managers"
    },
    {
      "name": "Preparation effort",
      "type": "single_select",
      "options": [
        "Low",
        "Medium",
        "High"
      ],
      "owner": "Resource owner screening"
    },
    {
      "name": "Instrumentation category",
      "type": "single_select",
      "options": [
        "Ready",
        "Existing needs adaptation",
        "New development",
        "Unknown feasibility",
        "No instrumentation support"
      ],
      "owner": "Instrumentation Owner"
    },
    {
      "name": "Resource team",
      "type": "text",
      "owner": "Resource managers; one task per team when needed"
    },
    {
      "name": "Test ID",
      "type": "text",
      "owner": "Testing Manager; derive from parent test issue number"
    },
    {
      "name": "Parent test",
      "type": "text",
      "owner": "Preparation work owner; full parent issue URL"
    },
    {
      "name": "Requirement IDs",
      "type": "text",
      "owner": "Subsystem Lead; DVP&R remains canonical"
    },
    {
      "name": "Test Lead",
      "type": "text",
      "owner": "Testing Manager"
    },
    {
      "name": "Instrumentation Owner",
      "type": "text",
      "owner": "Resource manager"
    },
    {
      "name": "Analysis Owner",
      "type": "text",
      "owner": "Subsystem Lead"
    },
    {
      "name": "Prep due",
      "type": "date",
      "owner": "Committed work owner + manager"
    },
    {
      "name": "Target test date",
      "type": "date",
      "owner": "Testing Manager; tentative before confirmed schedule"
    },
    {
      "name": "Test day",
      "type": "text",
      "owner": "Testing Manager; assign confirmed day only after technical readiness"
    },
    {
      "name": "Analysis due",
      "type": "date",
      "owner": "Analysis Owner + Subsystem Lead, during planning"
    },
    {
      "name": "Gate record",
      "type": "text",
      "owner": "Testing Manager; parent issue comment URL"
    }
  ],
  "views": [
    {
      "name": "Pipeline",
      "layout": "board",
      "filter": "\"Work type\":Test Disposition:Active -label:demo",
      "group_by": "Status"
    },
    {
      "name": "Preparation workload",
      "layout": "table",
      "filter": "\"Work type\":Preparation Disposition:Active -label:demo",
      "group_by": "Resource team",
      "sort_by": "Prep due",
      "note": "Keep all active tasks visible, including blocked work. Inspect manager commitments and capacity in parent records."
    },
    {
      "name": "Confirmed testing",
      "layout": "table",
      "filter": "\"Work type\":Test Disposition:Active status:Scheduled -label:demo",
      "group_by": "Test day",
      "sort_by": "Target test date",
      "note": "Only technically ready tests may become Scheduled; select one confirmed day. Ready backlog is not a confirmed schedule."
    },
    {
      "name": "Analysis backlog",
      "layout": "table",
      "filter": "\"Work type\":Test Disposition:Active status:Executed,Analyzing -label:demo",
      "group_by": "Analysis Owner",
      "sort_by": "Analysis due"
    },
    {
      "name": "Subsystem/DVP&R overview",
      "layout": "table",
      "filter": "\"Work type\":Test -label:demo",
      "group_by": "Subsystem",
      "note": "Show Requirement IDs and links; Markdown DVP&R holds coverage/status including requirements with no issues."
    }
  ],
  "configuration_status": "proposed; not applied",
  "approval_source": "dated decisions on parent test issue; not Project fields"
}
